{
    "private": true,
    "workspaces": {
        "packages": [
            "platform/core/*",
            "platform/packages/*",
            "platform/plugins/*",
            "platform/themes/*"
        ]
    },
    "scripts": {
        "dev": "mix",
        "build": "vite build",
        "preview": "vite preview",
        "dev:mix": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "format": "npx prettier platform/**/resources/js/**/*.{js,vue} platform/**/resources/sass/*.scss platform/**/resources/views/**/*.blade.php platform/themes/*/{layouts,partials,views,widgets}/**/*.blade.php platform/themes/*/assets/**/*.{js,scss} --write"
    },
    "devDependencies": {
        "@fullhuman/postcss-purgecss": "^6.0.0",
        "@shufo/prettier-plugin-blade": "^1.16.1",
        "@tailwindcss/postcss": "^4.1.17",
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitejs/plugin-vue-jsx": "^5.1.1",
        "@vue/babel-plugin-jsx": "^2.0.1",
        "autoprefixer": "^10.4.22",
        "cross-env": "^10.0.0",
        "css-loader": "^7.1.2",
        "glob": "^11.0.3",
        "laravel-mix": "^6.0.49",
        "laravel-vite-plugin": "^2.0.1",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.92.1",
        "sass-loader": "^16.0.5",
        "tailwindcss": "^4.1.17",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "vite": "^7.2.2",
        "vue-loader": "^17.3.0"
    },
    "dependencies": {
        "axios": "^1.12.0",
        "bootstrap": "5.3.7",
        "cropperjs": "^1.6.2",
        "epic-spinners": "^2.0.0",
        "jquery": "^3.7.1",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "sanitize-html": "^2.17.0",
        "swiper": "^12.0.3",
        "tiny-emitter": "^2.1.0",
        "vue": "^3.3.4"
    }
}
